<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/navigationmap/db" VERSION="20190403"
	COMMENT="XMLDB file for Navigationmap module"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
	<TABLES>
		<TABLE NAME="navigationmap"
			COMMENT="Each record is one navigationmap and its config data">
			<FIELDS>
				<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true"
					SEQUENCE="true" />
				<FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true"
					DEFAULT="0" SEQUENCE="false" />
				<FIELD NAME="module" TYPE="int" LENGTH="10" NOTNULL="true"
					SEQUENCE="false" />
				<FIELD NAME="coursemodule" TYPE="int" LENGTH="10" NOTNULL="true"
					SEQUENCE="false" />
				<FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"
					SEQUENCE="false" />
				<FIELD NAME="short_description" TYPE="char" LENGTH="255"
					NOTNULL="true" SEQUENCE="false" />
				<FIELD NAME="content" TYPE="text" NOTNULL="false"
					SEQUENCE="false" />
				<FIELD NAME="contentformat" TYPE="int" LENGTH="4"
					NOTNULL="true" DEFAULT="0" SEQUENCE="false" />
				<FIELD NAME="legacyfiles" TYPE="int" LENGTH="4" NOTNULL="true"
					DEFAULT="0" SEQUENCE="false" />
				<FIELD NAME="legacyfileslast" TYPE="int" LENGTH="10"
					NOTNULL="false" SEQUENCE="false" />
				<FIELD NAME="display" TYPE="int" LENGTH="4" NOTNULL="true"
					DEFAULT="0" SEQUENCE="false" />
				<FIELD NAME="displayoptions" TYPE="text" NOTNULL="false"
					SEQUENCE="false" />
				<FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true"
					DEFAULT="0" SEQUENCE="false"
					COMMENT="incremented when after each file changes, solves browser caching issues" />
				<FIELD NAME="timemodified" TYPE="int" LENGTH="10"
					NOTNULL="true" DEFAULT="0" SEQUENCE="false" />
				<FIELD NAME="is_map" TYPE="int" LENGTH="1" NOTNULL="true"
					DEFAULT="0" SEQUENCE="false" />
			</FIELDS>
			<KEYS>
				<KEY NAME="primary" TYPE="primary" FIELDS="id" />
			</KEYS>
			<INDEXES>
				<INDEX NAME="course" UNIQUE="false" FIELDS="course" />
			</INDEXES>
		</TABLE>
		<TABLE NAME="navigationmap_topics_to_room"
			COMMENT="topics belongs to one room">
			<FIELDS>
				<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true"
					SEQUENCE="true" />
				<FIELD NAME="navigationmap_id" TYPE="int" LENGTH="10"
					NOTNULL="true" SEQUENCE="false" />
				<FIELD NAME="topic_id" TYPE="int" LENGTH="10" NOTNULL="false"
					SEQUENCE="false" />
				<FIELD NAME="topic_shortdescription" TYPE="text"
					NOTNULL="false" SEQUENCE="false" />
				<FIELD NAME="topic_hotspot_xvalue" TYPE="char" LENGTH="4"
					NOTNULL="false" DEFAULT="0" SEQUENCE="false" />
				<FIELD NAME="topic_hotspot_yvalue" TYPE="char" LENGTH="4"
					NOTNULL="false" DEFAULT="0" SEQUENCE="false" />
				<FIELD NAME="topic_hotspot_number" TYPE="char" LENGTH="2"
					NOTNULL="false" DEFAULT="0" SEQUENCE="false" />
			</FIELDS>
			<KEYS>
				<KEY NAME="primary" TYPE="primary" FIELDS="id" />
				<KEY NAME="navigationmap_id" TYPE="foreign"
					FIELDS="navigationmap_id" REFTABLE="navigationmap" REFFIELDS="id" />
			</KEYS>
		</TABLE>
		<TABLE NAME="navigationmap_room_hotspots"
			COMMENT="hotspots for rooms">
			<FIELDS>
				<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true"
					SEQUENCE="true" />
				<FIELD NAME="navigationmap_id" TYPE="int" LENGTH="10"
					NOTNULL="true" SEQUENCE="false" />
				<FIELD NAME="room_id" TYPE="int" LENGTH="10" NOTNULL="true"
					SEQUENCE="false" />
				<FIELD NAME="room_hotspot_xvalue" TYPE="char" LENGTH="4"
					NOTNULL="true" DEFAULT="0" SEQUENCE="false" />
				<FIELD NAME="room_hotspot_yvalue" TYPE="char" LENGTH="4"
					NOTNULL="true" DEFAULT="0" SEQUENCE="false" />
				<FIELD NAME="room_hotspot_number" TYPE="char" LENGTH="2"
					NOTNULL="false" DEFAULT="0" SEQUENCE="false" />
			</FIELDS>
			<KEYS>
				<KEY NAME="primary" TYPE="primary" FIELDS="id" />
				<KEY NAME="navigationmap_id" TYPE="foreign"
					FIELDS="navigationmap_id" REFTABLE="navigationmap" REFFIELDS="id" />
			</KEYS>
		</TABLE>
	</TABLES>
</XMLDB>